# Template only. Supply values through the process environment or your host.
# No script automatically reads .env.
NODE_ENV=development
MCP_TRANSPORT=stdio
LOG_LEVEL=info

# Required in both modes. Startup reads metadata and validates schemas only.
NOTION_API=
NOTION_PROJECTS_DATABASE_ID=
NOTION_SUBPROJECTS_DATABASE_ID=
NOTION_KNOWLEDGE_DATABASE_ID=
# Optional NOTION_*_DATA_SOURCE_ID assertions must be omitted unless populated.
# Only this API version is approved.
NOTION_API_VERSION=2025-09-03

# Required only when MCP_TRANSPORT=http. Server stores SHA-256 digests only.
# Generate a separate strong random token for clients; never use NOTION_API.
# Supply exactly 64 hexadecimal characters. Keep values out of Git.
MCP_BEARER_TOKEN_SHA256=
# Optional MCP_BEARER_TOKEN_NEXT_SHA256 must be omitted unless populated.
# Legacy plaintext MCP_BEARER_TOKEN is rejected in HTTP mode.
MCP_PUBLIC_URL=
# Optional comma-separated HTTPS origins; paths, queries and credentials rejected.
MCP_ALLOWED_ORIGINS=
